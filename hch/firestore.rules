rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    // Head Office Admin/franchisor AND Head Office Staff have identical
    // permissions throughout the system.
    function headOffice() {
      return signedIn() &&
        (
          profile().role == "franchisor" ||
          profile().role == "Franchisor" ||
          profile().role == "Head Office Staff" ||
          profile().role == "Head Office Staff" ||
          profile().role == "head office staff" ||
          profile().role == "Head office staff"
        );
    }

    function franchisee() {
      return signedIn() &&
        (
          profile().role == "franchisee" ||
          profile().role == "Franchisee"
        );
    }

    function ownOffice(id) {
      return franchisee() && profile().officeId == id;
    }

    match /users/{uid} {
      allow read: if signedIn() &&
        (request.auth.uid == uid || headOffice());

      allow create: if signedIn() &&
        request.auth.uid == uid;

      allow update: if headOffice() ||
        request.auth.uid == uid;

      allow delete: if headOffice();
    }

    match /offices/{id} {
      allow read: if headOffice() || ownOffice(id);
      allow create, update, delete: if headOffice();
    }

    match /audits/{id} {
      allow read: if headOffice() || ownOffice(resource.data.officeId);
      allow create, delete, update: if headOffice();
    }

    match /auditSchedules/{id} {
      allow read: if headOffice() || ownOffice(resource.data.officeId);
      allow create, update, delete: if headOffice();
    }

    match /actions/{id} {
      allow read: if headOffice() || ownOffice(resource.data.officeId);

      allow create: if headOffice();

      allow update: if headOffice() || (
        ownOffice(resource.data.officeId) &&
        request.resource.data.officeId == resource.data.officeId &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "completedAt",
            "completedBy",
            "updatedAt"
          ])
      );

      allow delete: if headOffice();
    }

    match /evidence/{id} {
      allow read: if headOffice() || ownOffice(resource.data.officeId);
      allow create: if headOffice() || ownOffice(request.resource.data.officeId);
      allow update: if headOffice();
      allow delete: if headOffice();
    }
  }
}
