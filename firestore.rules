rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function profile(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function headOffice(){ return signedIn() && profile().role == "franchisor"; }
    function franchisee(){ return signedIn() && profile().role == "franchisee"; }
    function ownOffice(id){ return franchisee() && profile().officeId == id; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || headOffice());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if headOffice() || request.auth.uid == uid;
      allow delete: if headOffice();
    }
    match /offices/{id} {
      allow read: if headOffice() || ownOffice(id);
      allow create, update, delete: if headOffice();
    }
    match /audits/{id} {
      allow read: if headOffice() || ownOffice(resource.data.officeId);
      allow create, delete: if headOffice();
      allow update: if headOffice() || (ownOffice(resource.data.officeId) && request.resource.data.officeId == resource.data.officeId);
    }
    match /actions/{id} {
      allow read: if headOffice() || ownOffice(resource.data.officeId);
      allow create: if headOffice() || ownOffice(request.resource.data.officeId);
      allow update: if headOffice() || ownOffice(resource.data.officeId);
      allow delete: if headOffice();
    }
    match /evidence/{id} {
      allow read: if headOffice() || ownOffice(resource.data.officeId);
      allow create: if headOffice() || ownOffice(request.resource.data.officeId);
      allow update: if headOffice() || ownOffice(resource.data.officeId);
      allow delete: if headOffice();
    }
  }
}