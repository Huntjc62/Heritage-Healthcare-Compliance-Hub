rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isHeadOffice() {
      return signedIn() && userProfile().role == "franchisor";
    }

    function isFranchisee() {
      return signedIn() && userProfile().role == "franchisee";
    }

    function sameOffice(officeId) {
      return isFranchisee() && userProfile().officeId == officeId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isHeadOffice());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isHeadOffice());
      allow delete: if isHeadOffice();
    }

    match /offices/{officeId} {
      allow read: if isHeadOffice() || sameOffice(officeId);
      allow create, update, delete: if isHeadOffice();
    }

    match /audits/{auditId} {
      allow read: if isHeadOffice() || sameOffice(resource.data.officeId);
      allow create, delete: if isHeadOffice();

      allow update: if isHeadOffice()
        || (
          sameOffice(resource.data.officeId)
          && request.resource.data.officeId == resource.data.officeId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "responses", "score", "status", "completedAt", "completedBy"
          ])
        );
    }

    match /actions/{actionId} {
      allow read: if isHeadOffice() || sameOffice(resource.data.officeId);
      allow create: if isHeadOffice() || sameOffice(request.resource.data.officeId);
      allow update: if isHeadOffice() || sameOffice(resource.data.officeId);
      allow delete: if isHeadOffice();
    }
  }
}
